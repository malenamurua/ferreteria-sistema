# Copiar este archivo como ".env" y ajustar los valores.
# docker-compose lee automaticamente el archivo ".env" si existe en esta carpeta.

DB_NAME=ferreteria_db
DB_USER=postgres
DB_PASSWORD=postgres

# IMPORTANTE: cambiar esto por un valor largo y aleatorio antes de usar en producción
JWT_SECRET=CAMBIAR_ESTE_SECRETO_POR_UNO_LARGO_Y_SEGURO_EN_PRODUCCION_1234567890
